@page "/Tenants/{tenantPublicId:guid}/Warehouses"
@model Warehouse.Web.RazorPages.Pages.Tenants.WarehousesModel

@{
    ViewData["Title"] = "Warehouses";
}

<h1>Warehouses</h1>

@if (Model.Tenant is not null)
{
    <p>Tenant: <strong>@Model.Tenant.TenantName</strong></p>
}

<p>
    <a asp-page="/Tenants/Index">Back to tenants</a>
</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}
else if (Model.Warehouses.Count == 0)
{
    <p>This tenant has no warehouses.</p>
}
else
{
    <p>@Model.Warehouses.Count warehouse(s)</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Code</th>
                <th scope="col">Name</th>
                <th scope="col">Active</th>
                <th scope="col">Created (UTC)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var warehouse in Model.Warehouses)
            {
                <tr>
                    <td>@warehouse.WarehouseCode</td>
                    <td>@warehouse.WarehouseName</td>
                    <td>@(warehouse.IsActive ? "Yes" : "No")</td>
                    <td>@warehouse.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
}