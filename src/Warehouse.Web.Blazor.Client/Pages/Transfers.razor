@page "/transfers"
@using Warehouse.Contracts.InventoryTransferLines
@using Warehouse.Contracts.InventoryTransfers
@using Warehouse.Web.Blazor.Client.Services
@inject WarehouseApiClient Api
@implements IDisposable

<PageTitle>Transfers</PageTitle>

<h1>Transfers</h1>

<form @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <label for="transfer-search">Search transfers</label>
    <input 
        id="transfer-search"
        style="width:32rem; max-width: 100%;"
        @bind="_query"
        @bind:event="oninput"
        maxlength="100"
        readonly="@_busy"
        placeholder="Tenant, status, transfer GUID, SKU, product, or lot number" />

    <button disabled="@_busy" type="submit">Search</button>  
    <button disabled="@_busy" @onclick="RefreshAsync" type="button">Refresh</button>
</form>

@if (_busy)
{
    <p role="status">Working...</p>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        <p>@_error</p>

        @if (_traceId is not null)
        {
            <small>Reference: @_traceId</small>
        }
    </div>
}

@if (_searchLoaded && !_busy && _results.Count == 0)
{
    <p>No matching transfers.</p>
}

<div class="d-flex gap-2 align-items-center mb-3" aria-label="Transfer pages">
    <button 
        type="button" 
        disabled="@(_busy || Session.PreviousCursor is null)" 
        @onclick="() => Session.MovePageAsync(Session.PreviousCursor)">
        Previous
    </button>
    
    <button 
        type="button" 
        disabled="@(_busy || Session.NextCursor is null)" 
        @onclick="() => Session.MovePageAsync(Session.NextCursor)">
        Next
    </button>
    
    <label for="transfer-page-size">Results per page</label>
    <select id="transfer-page-size" @bind="_pageSize" disabled="@_busy">
        <option value="5">5</option>
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
    </select>

    <span>Apply with Search</span>
</div>
  
<table class="table">
    <thead>
        <tr>
            <th>Tenant</th>
            <th>Transfer</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var result in _results)
        {
            <tr 
                @key="result.InventoryTransferPublicId"
                class="@(_selectedTransfer?.InventoryTransferPublicId == result.InventoryTransferPublicId ? "table-active" : null)">

                <td>@result.Tenant.TenantName</td>
                <td>@result.InventoryTransferPublicId</td>
                <td>@result.TransferStatusCode</td>
                <td>
                    <button type="button" disabled="@_busy" @onclick="() => SelectAsync(result)">Inspect</button>
                </td>

            </tr>
        }
    </tbody>
</table>

@* if _selectedTransfer has a non-null value, call that value 'selectedTransfer' and render the following block *@
@if (_selectedTransfer is { } selectedTransfer)
{
    <h2>Transfer @selectedTransfer.InventoryTransferPublicId</h2>

    <p>
        <strong>Tenant:</strong> @selectedTransfer.Tenant.TenantName
        <strong>Status:</strong> @selectedTransfer.TransferStatusCode
    </p>

    @if (_selectedSource is { } source && _selectedDestination is { } destination)
    {
        <div class="row">
            <section class="col-md-6">
                <h3>Source</h3>

                <p>@source.WarehouseCode -- @source.WarehouseName</p>
                <p><strong>Location:</strong> @source.LocationCode</p>

                @if (!string.IsNullOrWhiteSpace(source.LocationDisplayName))
                {
                    <p>@source.LocationDisplayName</p>
                }

                @if (!source.WarehouseIsActive)
                {
                    <p class="text-danger">Source warehouse is inactive.</p>
                }

                @if (!source.LocationIsActive)
                {
                    <p class="text-danger">Source location is inactive.</p>
                }
            </section>

            <section class="col-md-6">
                <h3>Destination</h3>

                <p>@destination.WarehouseCode -- @destination.WarehouseName</p>
                <p><strong>Location:</strong> @destination.LocationCode</p>

                @if (!string.IsNullOrWhiteSpace(destination.LocationDisplayName))
                {
                    <p>@destination.LocationDisplayName</p>
                }

                @if (!destination.WarehouseIsActive)
                {
                    <p class="text-danger">Destination warehouse is inactive.</p>
                }

                @if (!destination.LocationIsActive)
                {
                    <p class="text-danger">Destination location is inactive.</p>
                }
            </section>
        </div>
    } 

    @if (!_fresh)
    {
        <p role="status">
            Showing the last loaded inspection data. Refresh this transfer before another command.
        </p>
    }


    @if (Session.Detail is null)
    {
        <p>Inspection details have not been loaded. Refresh this transfer to retrieve its lines.</p>
    }
    else if (_transferLines.Count == 0)
    {
        <p>This transfer has no lines.</p> 
    }
    else
    {
        <p class="text-muted">
            Source stock is from the last successful load and applies to each exact lot
            at the source location. Available means on-hand minus reserved.
            Finalization also checks expiry and activity.
        </p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Lot</th>
                        <th scope="col">Expiry</th>
                        <th scope="col">Requested</th>
                        <th scope="col">Source on-hand</th>
                        <th scope="col">Source reserved</th>
                        <th scope="col">Source available</th>
                        <th scope="col">Selection</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _transferLines)
                    {
                        <tr @key="line.InventoryTransferLineId"
                            class="@(line.InventoryTransferLineId == _selectedLineId ? "table-active" : null)">
                            <td>
                                <div><strong>@line.SKU</strong></div>
                                <div>@line.ProductName</div>

                                @if (!line.ProductIsActive)
                                {
                                    <div class="text-danger">Product is inactive.</div>
                                }
                            </td>
                            <td>@line.LotNumber</td>
                            <td class="text-nowrap">
                                @(line.ExpirationDate?.ToString("yyyy-MM-dd") ?? "No expiry")
                            </td>
                            <td class="text-nowrap">
                                @FormatQuantity(line.QuantityRequested, line.UnitOfMeasureCode)
                            </td>  

                            @if (line.SourceStock is { } sourceStock)
                            {
                                <td class="text-nowrap">
                                    @FormatQuantity(sourceStock.QuantityOnHand, line.UnitOfMeasureCode)
                                </td>
                                <td class="text-nowrap">
                                    @FormatQuantity(sourceStock.QuantityReserved, line.UnitOfMeasureCode)
                                </td>
                                <td class="text-nowrap">
                                    @FormatQuantity(sourceStock.QuantityAvailable, line.UnitOfMeasureCode)
                                </td>
                            }
                            else
                            {
                                <td colspan="3" class="text-warning">
                                    No balance for this lot at the source location.
                                </td>
                            }

                            <td>
                                <button 
                                    type="button" 
                                    disabled="@_busy"
                                    aria-label="@($"Select {line.SKU}, lot {line.LotNumber}")"
                                    aria-pressed="@(line.InventoryTransferLineId == _selectedLineId ? "true" : "false")"
                                    @onclick="() => SelectLine(line.InventoryTransferLineId)">
                                    Select line
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p>Finalization processes every line in this transfer.</p>

    @if (_reviewRequired)
    {
        <button type="button" disabled="@(_busy || !_fresh)" @onclick="Review">
            I reviewed the refreshed transfer
        </button>
    }

    <button type="button" disabled="@(!CanFinalize)" @onclick="FinalizeAsync">
        @(selectedTransfer.TransferStatusCode == "RECEIVED" ? "Retrieve completion" : "Finalize entire transfer")
    </button>


}

@if (Session.RelatedTenantPublicId is { } relatedTenantId)
{
    <TenantExplorer TenantPublicId="@relatedTenantId" Disabled="@_busy" RefreshVersion="@Session.RelatedRefreshVersion" @key="relatedTenantId" />
}

@if (_completion is { } completion)
{
    <div class="alert alert-success" role="status">
        Transfer @completion.Summary.InventoryTransferPublicId:
        @completion.Summary.TransferStatusCode.

        @(completion.Summary.IsReplay
            ? "Previously completed; existing result retrieved."
            : "Completion confirmed.")
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>SKU</th>
                <th>Lot</th>
                <th>Moved</th>
                <th>Movement</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movement in completion.Movements)
            {
                <tr>
                    <td>@movement.SKU</td>
                    <td>@movement.LotNumber</td>
                    <td>
                        @movement.QuantityMoved
                        @movement.UnitOfMeasureCode
                    </td>
                    <td>@movement.InventoryMovementId</td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private string _query = "";
    private int _pageSize = 25;
    private TransferWorkflowSession Session { get; set; } = null!;
    private IReadOnlyList<InventoryTransferResponse> _results => Session.Results;
    private InventoryTransferResponse? _selectedTransfer => Session.SelectedTransfer;
    private InventoryTransferLocationResponse? _selectedSource => Session.Detail?.Source;
    private InventoryTransferLocationResponse? _selectedDestination => Session.Detail?.Destination;
    private IReadOnlyList<InventoryTransferDetailLineResponse> _transferLines => Session.Detail?.Lines ?? [];
    private int? _selectedLineId => Session.SelectedLineId;
    private CompleteInventoryTransferResponse? _completion => Session.Completion;
    private string? _error => Session.Error;
    private string? _traceId => Session.TraceId;
    private bool _busy => Session.IsBusy;
    private bool _fresh => Session.IsFresh;
    private bool _reviewRequired => Session.ReviewRequired;
    private bool _searchLoaded => Session.SearchLoaded;
    private bool CanFinalize => Session.CanExecute;

    private static string FormatQuantity(decimal? quantity, string unit) => 
        quantity is { } value ?
        $"{value:0.####} {unit}" :
        "Unavailable"; 

    protected override async Task OnInitializedAsync()
    {
        Session = new(Api);
        await SearchAsync();
    }

    private Task SearchAsync() => Session.SearchAsync(_query, _pageSize);
    private Task SelectAsync(InventoryTransferResponse transfer) => Session.SelectAsync(transfer);
    private Task RefreshAsync() => Session.RefreshAsync();
    private Task FinalizeAsync() => Session.ExecuteAsync();
    private void SelectLine(int lineId) => Session.SelectLine(lineId);
    private void Review() => Session.Review();
    public void Dispose() => Session?.Dispose();
}