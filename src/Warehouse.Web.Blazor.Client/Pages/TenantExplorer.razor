@using Warehouse.Web.Blazor.Client.Services
@inject WarehouseApiClient Api
@implements IDisposable

<hr />

<h3>Related records</h3>

<button type="button" disabled="@(Explorer.IsLoading || Disabled)" @onclick="Explorer.RefreshAsync">Refresh related records</button>

@if (Explorer.Tenant is { } tenant)
{
    <p>Tenant: @tenant.TenantName :: Active: @tenant.IsActive</p>
}

@if (Explorer.IsLoading) { <p role="status">Loading related records...</p> }  
@if (Explorer.Error is not null) { <p role="alert">@Explorer.Error</p> }

@foreach (var warehouse in Explorer.Warehouses)
{ 
    <button 
        type="button"
        disabled="@(Explorer.IsLoading || Disabled)"
        aria-pressed="@(Stock.Scope?.WarehousePublicId == warehouse.WarehousePublicId ? "true" : "false")"
        @onclick="() => Stock.SelectAsync(new(TenantPublicId, warehouse.WarehousePublicId), warehouse.WarehouseName)">
        @warehouse.WarehouseCode -- @warehouse.WarehouseName
    </button>
}

@if (Stock.Scope is not null)
{
    <h4>Stock availability: @Stock.WarehouseName</h4>

    <button type="button" disabled="@(Stock.IsLoading || Disabled)" @onclick="Stock.RefreshAsync">Refresh stock report</button>

    <p>Low-stock threshold: @Stock.Scope.LowStockThreshold.ToString("0.####")</p>

    @if (Stock.IsLoading) { <p role="status">Loading stock report; the latest successful report remains visible.</p> }
    @if (Stock.Error is not null) { <p role="alert">@Stock.Error</p> }

    @if (Stock.HasSuccessfulReport)
    {
        <p>Last load completed: @Stock.LoadedAtUtc?.ToString("u") (client time... not a database snapshot timestamp).</p>

        @if (Stock.Latest.Count == 0) { 
            <p>No stock records were returned.</p> 
        } 
        else
        {
            <p>Report date (UTC): @string.Join(", ", Stock.Latest.Select(row => row.ReportDateUtc.ToString("yyyy-MM-dd")).Distinct())</p>

            <p class="text-muted">
                Expired stock means expired stock in active locations. Inactive-location stock is reported separately. Availability is not proof of transfer eligibility.
            </p>
            
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th>Available to pick</th>
                            <th>Eligible reserved</th>
                            <th>Expired on-hand</th>
                            <th>Inactive-location on-hand</th>
                            <th>Status</th>
                        </tr>
                    </thead> 
                    <tbody>
                        @foreach (var item in Stock.Latest)
                        {
                            <tr @key="item.ProductPublicId">
                                <td>@item.SKU</td>
                                <td>@item.ProductName</td>
                                <td>@Quantity(item.AvailableToPick, item.UnitOfMeasureCode)</td>
                                <td>@Quantity(item.EligibleReserved, item.UnitOfMeasureCode)</td>
                                <td>@Quantity(item.ExpiredOnHand, item.UnitOfMeasureCode)</td>
                                <td>@Quantity(item.InactiveLocationOnHand, item.UnitOfMeasureCode)</td>
                                <td>@item.StockStatus</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

<hr />

@code {
    // Parameter Attribute means: this property is an input that another component can supply
    [Parameter]
    public Guid TenantPublicId { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public int RefreshVersion { get; set; }

    private TenantExplorerSession Explorer { get; set; } = null!;
    private StockReportSession Stock => Explorer.Stock;
    private int _refreshVersion;
    private static string Quantity(decimal value, string unit) => $"{value:0.####} {unit}";
    protected override void OnInitialized() => Explorer = new(Api);

    protected override async Task OnParametersSetAsync()
    {
        if (Explorer.TenantPublicId != TenantPublicId)
        {
            _refreshVersion = RefreshVersion;
            await Explorer.SelectTenantAsync(TenantPublicId);
        }
        else if (_refreshVersion != RefreshVersion)
        {
            _refreshVersion = RefreshVersion;
            await Explorer.RefreshAsync();
        }
    }

    public void Dispose() => Explorer?.Dispose();
}
