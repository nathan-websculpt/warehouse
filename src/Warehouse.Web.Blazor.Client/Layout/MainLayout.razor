@inherits LayoutComponentBase

@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <WorkflowErrorBoundary @ref="_boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div role="alert" class="alert alert-danger">
                        <p>This view could not be displayed. Reload it to retrieve current data before another command.</p>
                        <p>Reference: @_boundary?.Reference</p>
                        <button type="button" @onclick="Reload">Reload view</button>
                    </div>
                </ErrorContent>
            </WorkflowErrorBoundary>
        </article>
    </main>
</div>

@code {
    private WorkflowErrorBoundary? _boundary;
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>
